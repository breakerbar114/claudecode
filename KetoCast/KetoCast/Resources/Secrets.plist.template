<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    SETUP: Copy this file to Secrets.plist and fill in your API keys.
    Secrets.plist is gitignored and will NOT be committed.

    OPENAI_API_KEY  → https://platform.openai.com/api-keys
    ANTHROPIC_API_KEY → https://console.anthropic.com/
    USDA_API_KEY    → https://api.nal.usda.gov/ (free, register)
-->
<plist version="1.0">
<dict>
    <key>OPENAI_API_KEY</key>
    <string>sk-YOUR_OPENAI_KEY_HERE</string>
    <key>ANTHROPIC_API_KEY</key>
    <string>sk-ant-YOUR_ANTHROPIC_KEY_HERE</string>
    <key>USDA_API_KEY</key>
    <string>DEMO_KEY</string>
</dict>
</plist>
